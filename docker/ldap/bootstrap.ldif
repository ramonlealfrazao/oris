# Dados do LDAP de laboratorio (sem senhas: o login de pessoas e feito pelo OIDC).
# Base dc=oris,dc=local e criada pelo proprio contêiner.
dn: ou=usuarios,dc=oris,dc=local
objectClass: organizationalUnit
ou: usuarios

dn: ou=grupos,dc=oris,dc=local
objectClass: organizationalUnit
ou: grupos

dn: uid=ana.admin,ou=usuarios,dc=oris,dc=local
objectClass: inetOrgPerson
uid: ana.admin
cn: Ana Administradora
sn: Administradora
mail: ana.admin@oris.example

