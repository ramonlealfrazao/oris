{$ORIS_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy app:5000
}

kc.{$ORIS_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	@admin path /admin* /realms/master*
	respond @admin 403
	reverse_proxy keycloak:8080
}
